{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ModHeim",
  "version": "0.3.1",
  "identifier": "com.modheim.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ModHeim",
        "width": 1240,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 660,
        "decorations": false,
        "center": true,
        "backgroundColor": "#14100c"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Valheim mod launcher",
    "longDescription": "ModHeim finds your Valheim install, manages BepInEx and Thunderstore mods in separate profiles, and launches the game modded or vanilla.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "ModHeim",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdCRjk0QzE4RjMwMTNEQjEKUldTeFBRSHpHRXo1ZTk2Yi9Db0V3bVVEQUh0UDRjR2srZTN4MDZLYVFYekYreEpXQlQxL3NhSCsK",
      "endpoints": [
        "https://github.com/HumandubleOfficial/ModHeim/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
